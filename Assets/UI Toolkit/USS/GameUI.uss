/* GameUI.uss */
/* ===== Common ===== */
.root { width: 100%; height: 100%; }
.safe-area { position: absolute; left: 0%; right: 0%; top: 0%; bottom: 0%; }
.layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }

.hidden { display: none; }

/* ===== Title ===== */
.title-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0,0,0,0.25);
}

/* Full-screen invisible click catcher ("press anywhere") */
.title-bg {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0,0,0,0);
}

.title-big {
    position: absolute;
    left: 0; right: 0;
    top: 90px;
    -unity-text-align: middle-center;
    font-size: 72px;
    -unity-font-style: bold;
    color: rgba(255,255,255,0.95);
}

.press-hint {
    position: absolute;
    left: 0; right: 0;
    bottom: 120px;
    -unity-text-align: middle-center;
    font-size: 30px;
    color: rgba(255,255,255,0.9);
}

.login-btn {
    position: absolute;
    left: 50%;
    top: 52%;
    width: 520px;
    height: 140px;
    margin-left: -260px;
    margin-top: -70px;
    font-size: 36px;
}

.login-popup {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: center;
    align-items: center;
}

.login-popup-box {
    width: 70%;
    max-width: 760px;
    padding: 28px;
    background-color: rgba(0,0,0,0.75);
    border-radius: 18px;
    gap: 14px;
}

.popup-title { font-size: 34px; -unity-font-style: bold; color: rgba(255,255,255,0.95); }
.popup-body { font-size: 26px; color: rgba(255,255,255,0.9); }

/* ===== Main ===== */
.main-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.hud-top {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 170px;
    padding-left: 22px;
    padding-right: 22px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(0,0,0,0.35);
}

.hud-left-wrap { flex-direction: row; align-items: center; gap: 18px; }

.profile-blank-btn {
    width: 92px;
    height: 92px;
    border-radius: 999px;
    background-color: rgba(255,255,255,0.12);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 26px;
}

.profile-block { flex-direction: column; }
.hud-nickname { font-size: 34px; -unity-font-style: bold; color: rgba(255,255,255,0.95); }

.hud-center-wrap { flex-grow: 1; }

.hud-right-wrap { flex-direction: row; align-items: center; gap: 14px; }

.currency-btn {
    height: 100px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(255,255,255,0.12);
    border-radius: 14px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.currency-btn:hover { background-color: rgba(255,255,255,0.14); }
.currency-btn:active { background-color: rgba(255,255,255,0.18); }

.currency-inner { flex-direction: row; align-items: center; gap: 10px; }
.currency-name { font-size: 24px; color: rgba(255,255,255,0.85); }
.currency-value { font-size: 28px; -unity-font-style: bold; color: rgba(255,255,255,0.95); }

.hamburger-right {
    width: 90px; height: 90px;
    font-size: 44px;
}

/* Dropdowns */
.dropdown {
    position: absolute;
    right: 0;
    top: 175px;
    width: 420px;
    padding: 16px;
    gap: 10px;
    background-color: rgba(0,0,0,0.78);
    border-radius: 16px;
}
.dropdown-title { font-size: 28px; -unity-font-style: bold; color: rgba(255,255,255,0.95); }
.dropdown-item { font-size: 24px; color: rgba(255,255,255,0.9); }
.dropdown-btn { height: 80px; font-size: 26px; }

/* Currency dropdown: tighter spacing */
#PopupCurrencies {
    padding: 12px;
    gap: 6px;
}

/* Hamburger dropdown: same thickness as the hamburger button */
.hamburger-dropdown {
    width: 90px;
    padding: 8px;
    gap: 8px;
}

.hamburger-dropdown .dropdown-btn {
    width: 90px;
    height: 90px;
    padding-left: 0;
    padding-right: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* ===== Stage Area ===== */
.stage-area {
    position: absolute;
    left: 0;
    right: 0;
    top: 30%;
    align-items: center;
    justify-content: center;
}

.stage-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 22px;
}

.stage-label {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgba(255,255,255,0.95);
}

.boss-challenge {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.boss-label {
    font-size: 18px;
    color: rgba(255,255,255,0.85);
    margin-bottom: 6px;
}

.boss-toggle {
    width: 34px;
    height: 34px;
}

/* Left side */
.hud-left {
    position: absolute;
    left: 0;
    top: 190px;
    bottom: 220px;
    width: 190px;
    padding: 12px;
    gap: 12px;
    flex-direction: column;
}
.side-btn { width: 170px; height: 86px; font-size: 28px; }

/* ===== Guide Button & Badge ===== */
.guide-btn-wrap {
    position: relative;
    width: 170px;
}

.guide-btn {
    width: 170px;
    height: 86px;
}

.guide-badge {
    position: absolute;
    top: -10px;
    right: -10px;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background-color: rgba(235, 60, 60, 0.92);
    color: rgba(255, 255, 255, 0.98);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

/* Bottom bar */
.bottom-bar {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 190px;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    background-color: rgba(0,0,0,0.4);
}
.tab-btn { width: 170px; height: 110px; font-size: 32px; }

/* ===== Push Panel (Bottom Sheet) ===== */
.panel-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.panel-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 190px;
    background-color: rgba(0,0,0,0.35);
}

.panel-sheet {
    position: absolute;
    left: 0; right: 0;
    bottom: 190px;
    height: 60%;
    min-height: 380px;
    background-color: rgba(0,0,0,0.72);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    padding: 20px;
    gap: 14px;
}

/* ===== Settings Modal ===== */
.settings-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0,0,0,0.65);
    justify-content: center;
    align-items: center;
}

.settings-panel {
    width: 88%;
    max-width: 760px;
    background-color: rgba(35, 30, 45, 0.95);
    border-radius: 18px;
    padding: 18px;
    gap: 12px;
    overflow: hidden;
}

.settings-titlebar {
    height: 74px;
    justify-content: center;
    align-items: center;
    background-color: rgba(0,0,0,0.28);
    border-radius: 14px;
}

.settings-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgba(255,255,255,0.95);
    -unity-text-align: middle-center;
}

.settings-subrow { flex-direction: row; justify-content: space-between; align-items: center; gap: 10px; }
.settings-chip-btn { height: 72px; flex-grow: 1; font-size: 24px; }
.settings-version { height: 72px; width: 220px; justify-content: center; align-items: center; background-color: rgba(255,255,255,0.10); border-radius: 12px; }
.settings-version-label { font-size: 24px; color: rgba(255,255,255,0.9); }

.settings-coupon-row { flex-direction: row; align-items: center; gap: 10px; }
.settings-coupon-tag { width: 150px; height: 62px; justify-content: center; align-items: center; background-color: rgba(0,0,0,0.28); border-radius: 10px; }
.settings-coupon-tag-label { font-size: 22px; color: rgba(255,255,255,0.9); }
.settings-coupon-field-wrap { flex-grow: 1; height: 62px; border-radius: 10px; background-color: rgba(255,255,255,0.10); padding-left: 10px; padding-right: 10px; justify-content: center; }
.settings-coupon-field { flex-grow: 1; }
.settings-coupon-btn { width: 110px; height: 62px; font-size: 22px; }

.settings-grid { flex-direction: row; gap: 14px; }
.settings-col { flex-grow: 1; gap: 10px; }

.settings-volume-row { flex-direction: row; align-items: center; gap: 10px; }
.settings-volume-label {
    width: 110px;
    font-size: 22px;
    color: rgba(255,255,255,0.9);
    flex-shrink: 0;
}

.settings-mute-btn {
    width: 100px;
    height: 54px;
    font-size: 22px;
    border-radius: 12px;
    background-color: rgba(255,255,255,0.10);
    color: rgba(255,255,255,0.95);
    flex-shrink: 0;
}
.settings-mute-btn.is-on { background-color: rgba(255,80,80,0.35); }
.settings-slider { flex-grow: 1; min-width: 0; flex-shrink: 1; }

/* Settings toggles: improve label visibility */
.settings-panel .unity-base-field__label,
.settings-panel .unity-toggle__text {
    color: rgba(255,255,255,0.95);
}

.settings-inquiry { height: 62px; justify-content: center; align-items: center; background-color: rgba(0,0,0,0.28); border-radius: 10px; }
.settings-inquiry-label { font-size: 22px; color: rgba(255,255,255,0.9); }

.settings-wide-btn { height: 70px; font-size: 24px; }
.settings-danger-btn { height: 70px; font-size: 24px; color: rgba(255,80,80,1); }

.settings-bottom-row { flex-direction: row; gap: 12px; }
.settings-bottom-btn { flex-grow: 1; height: 76px; font-size: 26px; }

.settings-hint-close {
    position: absolute;
    left: 0; right: 0; bottom: 38px;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: rgba(255,255,255,0.75);
}

/* ===== Toast ===== */
.toast-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    pointer-events: none;
}

.toast-box {
    padding: 16px 22px;
    background-color: rgba(0,0,0,0.7);
    border-radius: 10px;
}

.toast-text {
    font-size: 24px;
    color: rgba(255,255,255,0.95);
    -unity-text-align: middle-center;
}

/* ===== Party HUD (Bottom) ===== */
.party-hud {
    position: absolute;
    left: 0;
    right: 0;
    /* bottom은 스크립트에서 BottomBar/Panel Sheet 높이 기준으로 동적으로 조정 */
    bottom: 202px;
    height: 150px;
    padding-left: 16px;
    padding-right: 16px;
    justify-content: center;
    align-items: center;
}

.party-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 16px;
}

.party-member {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding: 10px;
    background-color: rgba(0,0,0,0.30);
    border-radius: 18px;
}

.party-portrait-btn {
    width: 74px;
    height: 74px;
    border-radius: 999px;
    background-color: rgba(255,255,255,0.10);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255,255,255,0.25);
    border-right-color: rgba(255,255,255,0.25);
    border-top-color: rgba(255,255,255,0.25);
    border-bottom-color: rgba(255,255,255,0.25);
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}
.party-portrait-btn:hover { background-color: rgba(255,255,255,0.12); }
.party-portrait-btn:active { background-color: rgba(255,255,255,0.16); }

.party-info-col {
    flex-direction: column;
    gap: 8px;
}

.party-hpbar {
    width: 180px;
    height: 16px;
    background-color: rgba(255,255,255,0.12);
    border-radius: 999px;
    overflow: hidden;
}

.party-hpfill {
    height: 100%;
    width: 100%;
    background-color: rgba(120,255,120,0.85);
}

.party-skill-row {
    flex-direction: row;
    gap: 8px;
}

.party-skill {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background-color: rgba(255,255,255,0.14);
    justify-content: center;
    align-items: center;
    position: relative;
}

.party-skill-cd-mask {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0,0,0,0.55);
    border-radius: 12px;
}

.party-skill-cd-text {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-text-align: middle-center;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgba(255,255,255,0.95);
}

/* ===== Guide Panel ===== */
.guide-sheet {
    height: 72%;
}

.guide-progress-bar {
    height: 14px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 6px;
}

.guide-progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgba(100, 210, 130, 0.9);
}

.guide-progress-label {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.75);
    -unity-text-align: middle-right;
    margin-bottom: 10px;
}

.guide-scroll {
    flex-grow: 1;
    overflow: hidden;
}

.guide-empty-hint {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.5);
    -unity-text-align: middle-center;
    padding-top: 40px;
}

/* 가이드 단계 행 */
.guide-step-row {
    flex-direction: row;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
}

.guide-step-done {
    opacity: 0.55;
}

/* 체크 버튼 */
.guide-check-btn {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.10);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.25);
    border-right-color: rgba(255, 255, 255, 0.25);
    border-top-color: rgba(255, 255, 255, 0.25);
    border-bottom-color: rgba(255, 255, 255, 0.25);
    font-size: 26px;
    -unity-font-style: bold;
    color: rgba(100, 210, 130, 0.95);
    -unity-text-align: middle-center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}
.guide-check-btn:hover { background-color: rgba(255, 255, 255, 0.14); }
.guide-check-btn:active { background-color: rgba(255, 255, 255, 0.20); }

/* 텍스트 영역 */
.guide-text-col {
    flex-grow: 1;
    flex-direction: column;
    gap: 6px;
}

.guide-step-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.95);
}

.guide-step-title-done {
    color: rgba(255, 255, 255, 0.45);
}

.guide-step-desc {
    font-size: 23px;
    color: rgba(255, 255, 255, 0.80);
}

.guide-step-hint {
    font-size: 21px;
    color: rgba(180, 200, 255, 0.75);
    margin-top: 4px;
}

/* Panel header (공통) */
.panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

.panel-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.95);
}

.panel-close-btn {
    width: 72px;
    height: 72px;
    font-size: 30px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.10);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgba(255, 255, 255, 0.9);
}

.panel-body-hint {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.5);
    -unity-text-align: middle-center;
}

/* ===== MageTower HUD ===== */
.mt-hud {
    position: absolute;
    left: 0;
    top: 300px;
    width: 126px;
    padding: 8px;
    gap: 8px;
    flex-direction: column;
    align-items: center;
}

.mt-hud-slot {
    width: 96px;
    height: 96px;
    border-radius: 14px;
    background-color: rgba(255,255,255,0.10);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255,255,255,0.18);
    border-right-color: rgba(255,255,255,0.18);
    border-top-color: rgba(255,255,255,0.18);
    border-bottom-color: rgba(255,255,255,0.18);
    justify-content: center;
    align-items: center;
    padding: 0;
    overflow: hidden;
}
.mt-hud-slot:hover { background-color: rgba(255,255,255,0.14); }
.mt-hud-slot:active { background-color: rgba(255,255,255,0.20); }

.mt-hud-slot-icon {
    width: 72px;
    height: 72px;
    -unity-background-scale-mode: scale-to-fit;
}

.mt-hud-slot-empty {
    font-size: 20px;
    color: rgba(255,255,255,0.35);
    -unity-text-align: middle-center;
}

.mt-hud-slot-name {
    font-size: 16px;
    color: rgba(255,255,255,0.75);
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 96px;
}

.mt-hud-tower-btn {
    width: 96px;
    height: 96px;
    border-radius: 14px;
    background-color: rgba(100,60,180,0.5);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(160,120,255,0.4);
    border-right-color: rgba(160,120,255,0.4);
    border-top-color: rgba(160,120,255,0.4);
    border-bottom-color: rgba(160,120,255,0.4);
    justify-content: center;
    align-items: center;
    padding: 0;
    font-size: 22px;
    color: rgba(255,255,255,0.9);
    -unity-font-style: bold;
}
.mt-hud-tower-btn:hover { background-color: rgba(100,60,180,0.65); }
.mt-hud-tower-btn:active { background-color: rgba(100,60,180,0.8); }

.mt-hud-slot-cooldown-mask {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0,0,0,0.6);
    border-radius: 12px;
}

.mt-hud-slot-cooldown-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgba(255,255,255,0.9);
}

.mt-hud-slot-casting {
    border-left-color: rgba(180,220,255,0.85);
    border-right-color: rgba(180,220,255,0.85);
    border-top-color: rgba(180,220,255,0.85);
    border-bottom-color: rgba(180,220,255,0.85);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    background-color: rgba(180,220,255,0.08);
    transition-property: border-color, background-color;
    transition-duration: 0.3s;
}

/* ===== MageTower Equip Popup ===== */
.mt-equip-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0,0,0,0.65);
    justify-content: center;
    align-items: center;
}

.mt-equip-panel {
    width: 92%;
    max-width: 900px;
    height: 70%;
    max-height: 680px;
    background-color: rgba(35, 30, 45, 0.95);
    border-radius: 18px;
    padding: 18px;
    gap: 14px;
    flex-direction: column;
}

.mt-equip-titlebar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.mt-equip-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgba(255,255,255,0.95);
}

.mt-equip-close {
    width: 72px;
    height: 72px;
    font-size: 30px;
    border-radius: 999px;
    background-color: rgba(255,255,255,0.10);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgba(255,255,255,0.9);
}

.mt-equip-body {
    flex-grow: 1;
    flex-direction: row;
    gap: 18px;
}

.mt-equip-slots-col {
    width: 130px;
    flex-direction: column;
    gap: 10px;
    align-items: center;
}

.mt-equip-slots-label {
    font-size: 22px;
    color: rgba(255,255,255,0.75);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.mt-equip-slot {
    width: 100px;
    height: 100px;
    border-radius: 14px;
    background-color: rgba(255,255,255,0.08);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255,255,255,0.20);
    border-right-color: rgba(255,255,255,0.20);
    border-top-color: rgba(255,255,255,0.20);
    border-bottom-color: rgba(255,255,255,0.20);
    justify-content: center;
    align-items: center;
    padding: 0;
}
.mt-equip-slot:hover { background-color: rgba(255,255,255,0.12); }

.mt-equip-slot-active {
    border-left-color: rgba(100,210,130,0.7);
    border-right-color: rgba(100,210,130,0.7);
    border-top-color: rgba(100,210,130,0.7);
    border-bottom-color: rgba(100,210,130,0.7);
}

.mt-equip-slot-icon {
    width: 70px;
    height: 70px;
    -unity-background-scale-mode: scale-to-fit;
}

.mt-equip-slot-empty-label {
    font-size: 18px;
    color: rgba(255,255,255,0.3);
}

.mt-inv-col {
    flex-grow: 1;
    flex-direction: column;
    gap: 10px;
}

.mt-inv-label {
    font-size: 22px;
    color: rgba(255,255,255,0.75);
    margin-bottom: 4px;
}

.mt-inv-scroll {
    flex-grow: 1;
    overflow: hidden;
}

.mt-inv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 12px;
    padding: 4px;
}

.mt-inv-item {
    width: 110px;
    height: 130px;
    border-radius: 12px;
    background-color: rgba(255,255,255,0.08);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px;
}
.mt-inv-item:hover { background-color: rgba(255,255,255,0.14); }
.mt-inv-item:active { background-color: rgba(255,255,255,0.20); }

.mt-inv-item-equipped {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(100,210,130,0.6);
    border-right-color: rgba(100,210,130,0.6);
    border-top-color: rgba(100,210,130,0.6);
    border-bottom-color: rgba(100,210,130,0.6);
}

.mt-inv-item-icon {
    width: 60px;
    height: 60px;
    -unity-background-scale-mode: scale-to-fit;
}

.mt-inv-item-name {
    font-size: 18px;
    color: rgba(255,255,255,0.85);
    -unity-text-align: middle-center;
}

.mt-inv-item-dmg {
    font-size: 16px;
    color: rgba(255,255,255,0.6);
    -unity-text-align: middle-center;
}

.mt-drag-ghost {
    position: absolute;
    width: 70px;
    height: 70px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.8;
}

/* ===== MageTower Detail Popup ===== */
.mt-detail-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0,0,0,0.55);
    justify-content: center;
    align-items: center;
}

.mt-detail-panel {
    width: 80%;
    max-width: 600px;
    background-color: rgba(35, 30, 45, 0.96);
    border-radius: 18px;
    padding: 22px;
    gap: 14px;
}

.mt-detail-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.mt-detail-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgba(255,255,255,0.95);
}

.mt-detail-close {
    width: 60px;
    height: 60px;
    font-size: 28px;
    border-radius: 999px;
    background-color: rgba(255,255,255,0.10);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgba(255,255,255,0.9);
}

.mt-detail-icon-row {
    flex-direction: row;
    align-items: center;
    gap: 16px;
}

.mt-detail-icon {
    width: 90px;
    height: 90px;
    border-radius: 14px;
    background-color: rgba(255,255,255,0.08);
    -unity-background-scale-mode: scale-to-fit;
}

.mt-detail-stats {
    flex-direction: column;
    gap: 6px;
}

.mt-detail-stat-label {
    font-size: 24px;
    color: rgba(255,255,255,0.85);
}

.mt-detail-stat-value {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgba(255,255,255,0.95);
}

.mt-detail-section {
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    background-color: rgba(0,0,0,0.25);
    border-radius: 12px;
}

.mt-detail-section-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgba(255,255,255,0.9);
}

.mt-detail-section-info {
    font-size: 20px;
    color: rgba(255,255,255,0.7);
}

.mt-detail-btn {
    height: 62px;
    font-size: 24px;
    border-radius: 12px;
}

.mt-detail-btn-enhance {
    background-color: rgba(80, 140, 220, 0.7);
    color: rgba(255,255,255,0.95);
}
.mt-detail-btn-enhance:hover { background-color: rgba(80, 140, 220, 0.85); }
.mt-detail-btn-enhance:disabled { background-color: rgba(80, 140, 220, 0.3); color: rgba(255,255,255,0.4); }

.mt-detail-btn-awaken {
    background-color: rgba(160, 80, 220, 0.7);
    color: rgba(255,255,255,0.95);
}
.mt-detail-btn-awaken:hover { background-color: rgba(160, 80, 220, 0.85); }
.mt-detail-btn-awaken:disabled { background-color: rgba(160, 80, 220, 0.3); color: rgba(255,255,255,0.4); }

.mt-detail-btn-reset {
    background-color: rgba(200, 70, 70, 0.6);
    color: rgba(255,255,255,0.9);
}
.mt-detail-btn-reset:hover { background-color: rgba(200, 70, 70, 0.75); }
.mt-detail-btn-reset:disabled { background-color: rgba(200, 70, 70, 0.2); color: rgba(255,255,255,0.35); }

.mt-detail-btn-row {
    flex-direction: row;
    gap: 10px;
}

.mt-detail-btn-row > .mt-detail-btn {
    flex-grow: 1;
}

/* ===== Damage Text ===== */
.damage-text-layer {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.damage-text {
    position: absolute;
    -unity-text-align: middle-center;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgba(255,80,80,0.95);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0,0,0,0.70);
}