<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="ScreenTitle" class="title-screen">

        <!-- Background click catcher: handles "press anywhere" without interfering with Login button/popup -->
        <ui:VisualElement name="BgClickCatcher" class="title-bg" />

        <ui:Label name="LblTitle" text="왕국군 키우기" class="title-big" />

        <ui:Button name="BtnLogin" text="로그인" class="login-btn" />

        <ui:Label name="LblPressHint" text="PRESS ANYWHERE TO CONTINUE" class="press-hint" />

        <!-- Login Popup -->
        <!-- Dimmed backdrop covers the screen; clicks outside the box close the popup -->
        <ui:VisualElement name="PopupLogin" class="login-popup hidden">
            <ui:VisualElement name="PopupLoginDim" class="login-popup-dim" />
            <ui:VisualElement name="PopupLoginBox" class="login-popup-box">
                <ui:VisualElement class="login-popup-header">
                    <ui:Label text="계정 로그인" class="login-popup-title" />
                    <ui:Button name="BtnLoginClose" text="×" class="login-popup-close" />
                </ui:VisualElement>

                <ui:Label text="계정을 선택하여 게임을 시작하세요." class="login-popup-subtitle" />

                <ui:VisualElement class="login-popup-divider" />

                <ui:VisualElement class="login-provider-list">
                    <ui:Button name="BtnLoginGuest" class="login-provider-btn login-provider-guest">
                        <ui:VisualElement class="login-provider-icon login-provider-icon-guest" />
                        <ui:Label text="게스트로 시작" class="login-provider-label" />
                    </ui:Button>

                    <ui:Button name="BtnLoginGoogle" class="login-provider-btn login-provider-google">
                        <ui:VisualElement class="login-provider-icon login-provider-icon-google" />
                        <ui:Label text="Google 계정으로 로그인" class="login-provider-label" />
                    </ui:Button>

                    <ui:Button name="BtnLoginApple" class="login-provider-btn login-provider-apple">
                        <ui:VisualElement class="login-provider-icon login-provider-icon-apple" />
                        <ui:Label text="Apple 계정으로 로그인" class="login-provider-label" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="login-popup-footer">
                    <ui:Label text="로그인 시 이용약관 및 개인정보 처리방침에 동의한 것으로 간주됩니다." class="login-popup-terms" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>