<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="ScreenTitle" class="title-screen">

        <!-- Background click catcher: handles "press anywhere" without interfering with Login button/popup -->
        <ui:VisualElement name="BgClickCatcher" class="title-bg" />

        <ui:Label name="LblTitle" text="왕국군 키우기" class="title-big" />

        <ui:Button name="BtnLogin" text="로그인" class="login-btn" />

        <ui:Label name="LblPressHint" text="PRESS ANYWHERE TO CONTINUE" class="press-hint" />

        <!-- Dummy Login Popup -->
        <!-- PopupLogin is set to pickingMode=Ignore in code so clicks outside the box pass through to BgClickCatcher -->
        <ui:VisualElement name="PopupLogin" class="login-popup hidden">
            <ui:VisualElement name="PopupLoginBox" class="login-popup-box">
                <ui:Label text="로그인 (더미 팝업)" class="popup-title" />
                <ui:Label text="MVP 단계에서는 기능이 없습니다." class="popup-body" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>