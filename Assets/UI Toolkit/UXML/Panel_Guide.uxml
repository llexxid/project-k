<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="PanelRoot" class="panel-root">
        <ui:VisualElement name="Backdrop" class="panel-backdrop" />

        <ui:VisualElement name="Sheet" class="panel-sheet guide-sheet">
            <ui:VisualElement class="panel-header">
                <ui:Label name="LblPanelName" text="가이드" class="panel-title" />
                <ui:Button name="BtnPanelClose" text="✕" class="panel-close-btn" />
            </ui:VisualElement>

            <!-- 진행도 요약 -->
            <ui:VisualElement name="GuideProgressBar" class="guide-progress-bar">
                <ui:VisualElement name="GuideProgressFill" class="guide-progress-fill" />
            </ui:VisualElement>
            <ui:Label name="LblGuideProgress" text="0 / 0 완료" class="guide-progress-label" />

            <!-- 단계 목록 (코드에서 동적으로 채워짐) -->
            <ui:ScrollView name="GuideScrollView" class="guide-scroll" vertical-scroller-visibility="Auto">
                <!-- UITKGuidePanelController.Populate() 에서 step row들을 추가 -->
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
